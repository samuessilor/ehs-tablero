# Plantilla del archivo de configuracion. El instalador copia esto a
# config/ehs.env y rellena los valores reales durante la instalacion — nunca a
# mano, y nunca este archivo (config/ehs.env esta excluido de git; esta
# plantilla si se versiona, sin credenciales, solo como referencia de forma).
#
# CLAVE=valor por linea. '#' al inicio comenta la linea entera. Las comillas
# alrededor del valor son opcionales.

# ----------------------------------------------------------- motor y base ---
SQL_SERVIDOR=127.0.0.1
SQL_PUERTO=14330
SQL_BASE=analitica
SQL_CONFIAR_CERT=1
SQL_CIFRAR=1

# ------------------------------- identidad de la aplicacion (solo DML) ---
# Usada por servidor.js para leer y para llamar a ehs.sp_capturar_lote. NO
# tiene permiso de crear ni alterar tablas: ver instalacion/crear-logins.sql.
SQL_USUARIO=ehs_app
SQL_CLAVE=

# ---------------------------- identidad del migrador (DDL, solo instalar/actualizar) ---
# Usada unicamente por scripts/migrar.js. La aplicacion nunca la lee.
SQL_MIGRADOR_USUARIO=ehs_migrador
SQL_MIGRADOR_CLAVE=

# ------------------------------------------------------- tiempos de espera ---
# Cuanto tarda en avisar que el motor no responde, en milisegundos. Con el
# motor en 127.0.0.1 estos valores alcanzan sobrado; no hay que subirlos por
# una red que aqui no existe.
SQL_TIMEOUT_CONEXION_MS=5000
SQL_TIMEOUT_CONSULTA_MS=15000
