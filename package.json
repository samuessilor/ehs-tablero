{
  "name": "ehs-tablero",
  "version": "1.0.0",
  "private": true,
  "description": "Tablero de indicadores EHS - EssilorLuxottica LATAM. Stack del estandar de integracion: Node + EJS + CSS + JS + ECharts. Interinato en Vercel; destino: servidor propio de la empresa (fase 1).",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node servidor.js",
    "lint": "eslint src api servidor.js public/js",
    "format": "prettier --write \"src/**/*.js\" \"api/**/*.js\" \"public/js/**/*.js\" \"public/css/**/*.css\" servidor.js eslint.config.js",
    "format:check": "prettier --check \"src/**/*.js\" \"api/**/*.js\" \"public/js/**/*.js\" \"public/css/**/*.css\" servidor.js eslint.config.js"
  },
  "dependencies": {
    "ejs": "^3.1.10"
  },
  "devDependencies": {
    "echarts": "^6.1.0",
    "eslint": "^10.14.0",
    "prettier": "^3.3.3"
  },
  "optionalDependencies": {
    "mssql": "^12.7.1",
    "pg": "^8.13.1"
  }
}
