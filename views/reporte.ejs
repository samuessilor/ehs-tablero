<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex,nofollow" />
<title><%= titulo %></title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" />
<link rel="stylesheet" href="/css/ehs.css" />
<link rel="icon" href="data:," />
<style>
  /* La pantalla se ve como el resto del tablero; el papel no. @media print apaga
     todo lo que solo tiene sentido en una pantalla (navegación, botones, la franja
     de fondo del encabezado) y deja una hoja en blanco y negro que se lee bien
     impresa o guardada como PDF desde el propio diálogo de impresión del navegador —
     por eso no hay generación de PDF en el servidor: el navegador ya sabe hacerlo, y
     un renderizador aparte solo duplicaría esa capacidad para producir el mismo papel. */
  .rep-acciones { display: flex; gap: 10px; margin: 0 0 18px; align-items: center; }
  .rep-kpi { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(12, 1fr); gap: 14px; margin: 0 0 18px; }
  .rep-kpi-titulo { grid-column: 1 / -1; display: flex; align-items: baseline; gap: 10px; padding: 6px 0 2px; border-top: 2px solid var(--borde); }
  .rep-kpi-titulo:first-child { border-top: none; }
  .rep-kpi-titulo h2 { margin: 0; font-family: var(--cond); font-size: 17px; }
  .rep-kpi-titulo .sub { font-family: var(--mono); font-size: 10px; letter-spacing: .08em; color: var(--tenue); text-transform: uppercase; }
  .rep-texto { font-size: 12.5px; line-height: 1.55; color: var(--tinta); }
  .rep-tabla { width: 100%; border-collapse: collapse; font-size: 12.5px; }
  .rep-tabla th, .rep-tabla td { padding: 7px 10px; border-bottom: 1px solid var(--borde); text-align: left; }
  .rep-tabla th { font-family: var(--mono); font-size: 9px; letter-spacing: .08em; text-transform: uppercase; color: var(--tenue); }
  .rep-tabla td.num { text-align: right; font-variant-numeric: tabular-nums; }
  .rep-referencia { font-size: 10.5px; color: var(--tenue); }
  .rep-modal { position: fixed; inset: 0; z-index: 100; display: none; background: rgba(10,10,12,.55); align-items: center; justify-content: center; }
  .rep-modal.abierto { display: flex; }
  .rep-modal-caja { background: var(--sup); border-radius: 4px; max-width: 460px; width: calc(100% - 32px); max-height: 80vh; overflow: auto; padding: 20px 22px; }
  .rep-modal-caja h2 { margin: 0 0 4px; font-family: var(--cond); font-size: 17px; }
  .rep-modal-caja .sub { font-size: 12px; color: var(--tenue); margin: 0 0 14px; }
  .rep-check { display: flex; align-items: center; gap: 9px; padding: 7px 0; border-bottom: 1px solid var(--borde); font-size: 13px; }
  .rep-check input { width: 16px; height: 16px; }
  .rep-modal-pie { display: flex; gap: 10px; margin-top: 16px; justify-content: flex-end; }
  .rep-modal-link { font-size: 11.5px; color: var(--inst); background: none; border: none; cursor: pointer; padding: 0; text-decoration: underline; }
  .pie-credito-fija { font-size: 9.5px; opacity: .7; color: var(--tenue); }
  @media print {
    header.rail, .rep-acciones, .rep-modal, footer.pie script, .no-imprimir { display: none !important; }
    body { background: #fff; }
    /* espacio de sobra para el credito fijo del pie, en todas las paginas */
    main.body { max-width: none; padding: 0 0 26px; }
    .panel, .rep-kpi-titulo { break-inside: avoid; border: 1px solid #ccc; box-shadow: none; }
    .rep-kpi[data-excluido] { display: none !important; }
    /* Un panel de una sola grafica (sin "02 contra el año anterior", ej. Frequency
       rate/Accidentes DAFW cuando el ambito no tiene cierre historico) quedaba muy
       pegado al titulo de la siguiente magnitud: el margen inferior no alcanzaba a
       leerse como separacion real entre dos secciones distintas. */
    .rep-kpi { margin-bottom: 30px; }
    .rep-kpi-titulo { margin-top: 6px; padding-top: 10px; }
    footer.pie { margin-top: 24px; padding-top: 14px; }
    /* credito discreto, repetido al pie de CADA hoja impresa - no solo de la ultima,
       que es donde caia por estar al final del documento en el flujo normal. */
    .pie-credito-fija {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 4px;
      /* .pie-nota (heredada) trae max-width:74ch: sin anularlo aqui, la caja se
         angosta a ese ancho y con left/right fijos queda pegada a la izquierda en
         vez de ocupar toda la hoja - text-align:center solo centraba el texto
         DENTRO de esa caja angosta, no la caja en la hoja. Verificado con
         emulacion de medio "print": sin este max-width, left=0 y width=el ancho
         completo de la pagina. */
      max-width: none;
      text-align: center;
    }
  }
</style>
</head>
<body>

<header class="rail no-imprimir">
  <div class="rail-in">
    <div class="marca">
      <a href="/" aria-label="Ir al tablero"><img src="/img/servioptica-logo.png" alt="Servióptica" /></a>
      <div>
        <div class="t">Descargar reporte</div>
        <div class="s">Resumen imprimible del corte publicado</div>
      </div>
    </div>
    <div class="ctl rail-derecha">
      <a class="volver" href="/">← Volver al tablero</a>
    </div>
  </div>
</header>

<%- include('parciales/franja_estado.ejs') %>

<main class="body">

<% if (!pan) { %>
  <section class="panel c12">
    <div class="cuerpo"><p>Sin datos publicados todavía para este ámbito.</p></div>
  </section>
<% } else { %>

  <div class="rep-acciones no-imprimir">
    <button type="button" class="cap-boton" id="btnDescargar">Descargar / imprimir</button>
    <a class="cap-boton cap-boton-suave" href="/api/ehs/detalle?formato=csv">Descargar el detalle en CSV</a>
    <a class="cap-boton cap-boton-suave" href="/api/ehs/detalle?formato=excel">Descargar el detalle en Excel</a>
  </div>

  <section class="panel c12">
    <header><h2>EHS · <%= pan.ambito.nombre %></h2>
      <span class="sub">Corte <%= pan.corte.nombre %> <%= pan.anio %></span></header>
    <div class="cuerpo">
      <table class="rep-tabla">
        <thead>
          <tr>
            <th>Indicador</th>
            <th class="num">Acumulado (YTD)</th>
            <th class="num">Meta</th>
            <th class="num">Brecha vs. meta</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody>
          <% var CLASE = { cumple: 'cumple', riesgo: 'riesgo', incumple: 'incumple',
                            sin_meta: 'sinmeta', sin_dato: 'pend' }; %>
          <% var ETIQUETA = { cumple: 'Cumple', riesgo: 'En riesgo', incumple: 'Incumple',
                               sin_meta: 'Sin meta', sin_dato: 'Sin dato' }; %>
          <%# Coma decimal, como el tablero: con toFixed el reporte impreso decia "5.108",
              que en Colombia se lee cinco mil ciento ocho. %>
          <% var n = function (v, d) { return v == null ? '—' : Number(v).toLocaleString('es-CO',
               { minimumFractionDigits: d, maximumFractionDigits: d }); }; %>
          <% pan.kpi.forEach(function (k) { %>
          <tr>
            <td>
              <%= k.kpi %> <span class="rep-referencia">(<%= k.unidad %>)</span>
              <% if (k.es_referencia) { %><br /><span class="rep-referencia">meta de referencia, no propia del ámbito</span><% } %>
            </td>
            <td class="num"><%= n(k.valor, k.dec) %></td>
            <%# la meta con sus propios decimales: 1,9 y no "2" (el estado se calcula contra 1,9) %>
            <td class="num"><%= k.meta == null ? '—' : Number(k.meta).toLocaleString('es-CO',
                  { minimumFractionDigits: k.dec, maximumFractionDigits: Math.max(k.dec, 2) }) %></td>
            <td class="num"><%= k.brecha_pct == null ? '—' : (k.brecha_pct > 0 ? '+' : '') + n(k.brecha_pct * 100, 1) + ' %' %></td>
            <td><span class="chip <%= CLASE[k.estado] || 'sinmeta' %>"><%= ETIQUETA[k.estado] || k.estado %></span></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </section>

  <%
    /* Un bloque "01 mensual/YTD/meta + 02 contra el año anterior" por cada KPI que
       de verdad tiene dato en este ámbito — Peru, por ejemplo, no reporta
       accidentes/frequency_rate todavia, y un bloque vacío no informa nada. */
    var kpisConDato = pan.kpi.filter(function (k) { return k.valor !== null; });
  %>
  <% kpisConDato.forEach(function (k) { %>
  <div class="rep-kpi" data-kpi="<%= k.kpi_id %>" id="bloque-<%= k.kpi_id %>">
    <div class="rep-kpi-titulo">
      <h2><%= k.kpi %></h2>
      <span class="sub"><%= k.unidad %></span>
    </div>
    <section class="panel c7">
      <header><span class="ix">01</span><h2>Mensual, YTD y meta</h2><span class="sub" id="sub1-<%= k.kpi_id %>"></span></header>
      <div class="grafico alto" id="g1-<%= k.kpi_id %>"></div>
    </section>
    <section class="panel c5">
      <header><span class="ix">02</span><h2>Contra el año anterior</h2><span class="sub" id="sub2-<%= k.kpi_id %>"></span></header>
      <div class="grafico alto" id="g2-<%= k.kpi_id %>"></div>
    </section>
    <section class="panel c12">
      <div class="cuerpo rep-texto" id="texto-<%= k.kpi_id %>"></div>
    </section>
  </div>
  <% }); %>

  <footer class="pie">
    <div class="pie-in">
      <div><span class="et">Fuente</span><b><%= pan.fuente %></b></div>
      <div><span class="et">Meta vigente</span><b><%= pan.meta_vigente %></b></div>
      <div><span class="et">Generado</span><b><%= generadoEn %></b></div>
    </div>
    <p class="pie-nota">
      Todo el análisis de esta página lo produce el código a partir del dato servido por
      <code>/api/ehs/*</code>. Ninguna conclusión ni ninguna cifra está escrita a mano.
    </p>
    <p class="pie-nota pie-credito-fija">
      Reporte generado por el Dashboard EHS · Elaborado por Samuel Galeano
    </p>
  </footer>

  <div class="rep-modal no-imprimir" id="modalDescarga">
    <div class="rep-modal-caja">
      <h2>Qué incluir</h2>
      <p class="sub">Todo viene preseleccionado. Quita lo que no quieras y descarga.</p>
      <div id="listaCheck">
        <% kpisConDato.forEach(function (k) { %>
        <label class="rep-check">
          <input type="checkbox" checked data-kpi="<%= k.kpi_id %>" />
          <%= k.kpi %>
        </label>
        <% }); %>
      </div>
      <div class="rep-modal-pie">
        <button type="button" class="rep-modal-link" id="btnCancelar">Cancelar</button>
        <button type="button" class="cap-boton" id="btnConfirmar">Descargar</button>
      </div>
    </div>
  </div>

<% } %>

</main>
<script src="/vendor/echarts.min.js"></script>
<script src="/js/formato.js"></script>
<script src="/js/graficos.js"></script>
<script src="/js/franja_estado.js"></script>
<script src="/js/reporte.js"></script>
</body>
</html>
