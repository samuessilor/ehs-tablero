<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex,nofollow" />
<title><%= titulo %></title>
<link rel="stylesheet" href="/css/ehs.css" />
</head>
<body>
<div id="tip" role="tooltip" aria-hidden="true"></div>
<p class="sr" id="viva" role="status" aria-live="polite"></p>

<header class="rail">
  <div class="rail-in">
    <div class="marca">
      <div>
        <div style="font-weight:700;font-size:14px;letter-spacing:-.01em">Tablero EHS · Servióptica</div>
        <div style="font-family:var(--mono);font-size:8.5px;letter-spacing:.14em;color:#8FD3D3;text-transform:uppercase">
          Stack de integración · Node + EJS + ECharts · <%= anio %>
        </div>
      </div>
    </div>

    <div class="ctl">
      <label class="et" for="segSitio">Sitio</label>
      <div class="seg" id="segSitio" role="group" aria-label="Sitio"></div>
    </div>

    <div class="ctl">
      <label class="et" for="segMes">Mes de corte</label>
      <div class="seg" id="segMes" role="group" aria-label="Mes de corte"></div>
    </div>

    <div class="ctl rail-derecha">
      <span class="et">Última actualización</span>
      <span style="font-family:var(--mono);font-size:11px;color:#D6E4EE" id="actualizadoEn"><%= actualizadoEn || '—' %></span>
    </div>
  </div>

  <nav class="rail-nav" aria-label="Vistas">
    <div class="nav-in" id="navVistas"></div>
  </nav>
</header>

<%- include('franja_estado.ejs') %>

<div class="tira">
  <div class="tira-in" id="tiraEstado"></div>
</div>
